# --- Secrets: never commit real Supabase keys -------------------------------
# `.env` files are ignored everywhere, except the two committed templates:
#   • .env.example            – documentation template
#   • assets/env/.env         – PLACEHOLDER bundle (required by pubspec assets)
# After pasting your real keys into assets/env/.env, stop git from tracking it:
#   git update-index --skip-worktree assets/env/.env
.env
!.env.example
assets/env/.env*
!assets/env/.env

# --- Flutter / Dart ---------------------------------------------------------
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
pubspec.lock

