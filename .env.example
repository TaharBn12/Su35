# Copy this file to `assets/env/.env` and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
#
# NOTE: `SUPABASE_ANON_KEY` / `SUPABASE_PUBLISHABLE_KEY` are *public* client keys.
# Security comes from Row Level Security (see supabase/migrations), never from
# hiding this key. NEVER put the `service_role` key in the app.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Legacy projects: the `eyJhbGci...` anon key
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# New projects: the `sb_publishable_...` key (preferred; takes priority if both are set)
SUPABASE_PUBLISHABLE_KEY=

# Storage bucket used for attachments (created by the SQL migration)
SUPABASE_STORAGE_BUCKET=attachments
