# ══════════════════════════════════════════════════════════════════
#  SU-35 Notes — متغيرات البيئة
#  انسخ هذا الملف باسم .env ثم املأ القيم من لوحة تحكم Supabase:
#  Project Settings → API Keys
#  ملاحظة: ملف .env مستثنى من Git ولا يُرفع إطلاقًا.
# ══════════════════════════════════════════════════════════════════

# رابط المشروع: https://<project-ref>.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# المفتاح العام (Publishable key الجديد sb_publishable_... أو مفتاح anon القديم)
# كلاهما آمن للاستخدام في تطبيق العميل، ولا يُغني عن سياسات RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
