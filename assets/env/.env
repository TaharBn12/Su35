# ⚠ PLACEHOLDER — committed on purpose so a fresh clone can build.
# Overwrite these values with your own project's keys; they stay local because
# this file is excluded from future commits only if you keep real keys elsewhere.
# (Recommended: keep your real keys here and NEVER commit them —
#  `git update-index --skip-worktree assets/env/.env` after filling it in.)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments
